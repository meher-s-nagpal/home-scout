# Copy to .env and fill in, then set email.enabled: true in config.yaml
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
HOME_SCOUT_SMTP_HOST=smtp.gmail.com
HOME_SCOUT_SMTP_PORT=587
HOME_SCOUT_SMTP_USER=you@gmail.com
HOME_SCOUT_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
HOME_SCOUT_EMAIL_TO=you@gmail.com
# HOME_SCOUT_EMAIL_FROM=you@gmail.com
